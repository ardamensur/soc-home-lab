# LAB Custom Rules - Network-layer detection
# SOC Home Lab - Suricata custom rules mapped to MITRE ATT&CK

# T1046 - Nmap SYN scan
alert tcp any any -> $HOME_NET any (msg:"LAB CUSTOM - Nmap SYN Scan Detected"; flags:S; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000001; rev:1; metadata:mitre_technique_id T1046, mitre_tactic reconnaissance;)

# T1110 - SMB Brute Force
alert tcp any any -> $HOME_NET 445 (msg:"LAB CUSTOM - SMB Brute Force Attempt"; flow:to_server; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-admin; sid:1000002; rev:1; metadata:mitre_technique_id T1110, mitre_tactic credential-access;)

# T1110 - SSH Brute Force
alert tcp any any -> $HOME_NET 22 (msg:"LAB CUSTOM - SSH Brute Force Attempt"; flow:to_server; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:1000003; rev:1; metadata:mitre_technique_id T1110, mitre_tactic credential-access;)
